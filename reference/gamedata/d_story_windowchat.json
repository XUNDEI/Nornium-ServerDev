'/Game/_Game/SoundEffects/Voice_Story/2/cue/xinfeng_109_Cue.xinfeng_109_Cue'","showTime":2,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol10501_png.idol10501_png'","roleTitle":"义人","roleName":"信风","next":106018,"showText":"你们战斗情况如何？"},"106018":{"id":106018,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/titibofu_63_Cue.titibofu_63_Cue'","showTime":4,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11101_png.idol11101_png'","roleTitle":"","roleName":"缇缇波芙","next":106019,"showText":"理事会的守卫又多又烦，不过我们应付得来。"},"106019":{"id":106019,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/titibofu_64_Cue.titibofu_64_Cue'","showTime":7,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11101_png.idol11101_png'","roleTitle":"","roleName":"缇缇波芙","next":106020,"showText":"而且我还在战场上缴获了很不错的巧克力。正在吃呢你听咕叽咕叽……"},"106020":{"id":106020,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/kesiming_052_Cue.kesiming_052_Cue'","showTime":5,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/npc20000_png.npc20000_png'","roleTitle":"","roleName":"科斯明船长","next":0,"showText":"不要担心，信风。我们没有危险，你那边才——【信号中断】"},"106021":{"id":106021,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xiaoyu_203_Cue.xiaoyu_203_Cue'","showTime":3,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11202_png.idol11202_png'","roleTitle":"船员","roleName":"小鱼","next":106022,"showText":"呜呜……瞄准、移动、躲避……"},"106022":{"id":106022,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xinfeng_194_Cue.xinfeng_194_Cue'","showTime":1,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol10501_png.idol10501_png'","roleTitle":"义人","roleName":"信风","next":106023,"showText":"1"},"106023":{"id":106023,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xinfeng_195_Cue.xinfeng_195_Cue'","showTime":1,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol10501_png.idol10501_png'","roleTitle":"义人","roleName":"信风","next":106024,"showText":"感觉如何？"},"106024":{"id":106024,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xiaoyu_204_Cue.xiaoyu_204_Cue'","showTime":2,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11202_png.idol11202_png'","roleTitle":"船员","roleName":"小鱼","next":106025,"showText":"我感觉……我觉得……"},"103001":{"id":103001,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xiaoyu_68_Cue.xiaoyu_68_Cue'","showTime":4,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11202_png.idol11202_png'","roleTitle":"北冕座π星的祭主","roleName":"鱼啄雨","next":103002,"showText":"我……我上当了吗……？"},"103002":{"id":103002,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xinfeng_024_Cue.xinfeng_024_Cue'","showTime":1,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol10501_png.idol10501_png'","roleTitle":"复乐园理事会","roleName":"助手","next":103003,"showText":"1。"},"103003":{"id":103003,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xiaoyu_69_Cue.xiaoyu_69_Cue'","showTime":4,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol11202_png.idol11202_png'","roleTitle":"北冕座π星的祭主","roleName":"鱼啄雨","next":103004,"showText":"可是，一切都那么突然……现在的情况……到底……"},"103004":{"id":103004,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Story/2/cue/xinfeng_025_Cue.xinfeng_025_Cue'","showTime":4,"headPath":"/Script/Paper2D.PaperSprite'/Game/_Game/TP_New/IdolProfile_res/Frames/idol10501_png.idol10501_png'","roleTitle":"复乐园理事会","roleName":"助手","next":103005,"showText":"他们想买你的本命星。你没有卖的理由。"},"106009":{"id":1