{"702015":{"id":702015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1002/Cue/SC_1002_end1_VS.SC_1002_end1_VS'","next":0,"showTime":2,"npcID":"700001","showText":"当然……你，是除外的那一个。"},"701011":{"id":701011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_KickBoard_VS.SC_1001_KickBoard_VS'","next":0,"showTime":2,"npcID":"700001","showText":"水面，像镜子，映照我曾经存在过的证据。"},"701012":{"id":701012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_tease_d_VS.SC_1001_tease_d_VS'","next":0,"showTime":2,"npcID":"700001","showText":"我做了……噩梦……梦见自己变成机器人……"},"701013":{"id":701013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_Shower_VS.SC_1001_Shower_VS'","next":0,"showTime":2,"npcID":"700001","showText":"我是不溶于水的。"},"701014":{"id":701014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_tease_g_VS.SC_1001_tease_g_VS'","next":0,"showTime":2,"npcID":"700001","showText":"水流，冲刷着外壳……希望，也能冲走一些回忆……"},"701015":{"id":701015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_SunBath_VS.SC_1001_SunBath_VS'","next":0,"showTime":2,"npcID":"700001","showText":"阳光下，这具身体的颜色，很漂亮。"},"701016":{"id":701016,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_end0_VS.SC_1001_end0_VS'","next":0,"showTime":2,"npcID":"700001","showText":"仿钻折光。我不喜欢的名字。但我记得，你说过，喜欢。"},"701017":{"id":701017,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_end1_VS.SC_1001_end1_VS'","next":0,"showTime":2,"npcID":"700001","showText":"我也无法长久封存泪水中的力量，就像泪瓶无法永远封存悲伤。"},"701018":{"id":701018,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1001/Cue/SC_1001_end2_VS.SC_1001_end2_VS'","next":0,"showTime":2,"npcID":"700001","showText":"虽然我还……不太适应这样的生活……但是……有你在……"},"700001":{"id":700001,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/biancaiji_bubble_01.biancaiji_bubble_01'","next":700002,"showTime":1,"npcID":"700001","showText":"来了，老弟！"},"700002":{"id":700002,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/nijique_bubble_02.nijique_bubble_02'","next":0,"showTime":1,"npcID":"700001","showText":"想喝点嘛？"},"700003":{"id":700003,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/biancaiji_bubble_01.biancaiji_bubble_01'","next":700004,"showTime":1,"npcID":"700001","showText":"下次再来玩！"},"700004":{"id":700004,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/nijique_bubble_02.nijique_bubble_02'","next":0,"showTime":1,"npcID":"700001","showText":"哎，喂，小哥你钱掉了！"},"100000":{"id":100000,"soundCue":"","next":100001,"showTime":5,"npcID":"101001","showText":"购买三门以上副炮，有88折优惠哦。"},"100001":{"id":100001,"soundCue":"","next":0,"showTime":5,"npcID":"101001","showText":"还送「多冰少沙」一年期每日畅饮卡哦。"},"100002":{"id":100002,"soundCue":"","next":100003,"showTime":7,"npcID":"101002","showText":"最近，在附近的星域，遇到了念形虫类的「败者」……"},"100003":{"id":100003,"soundCue":"","next":100004,"showTime":3,"npcID":"101003","showText":"哦，真罕见啊。"},"100004":{"id":100004,"soundCue":"","next":100005,"showTime":8,"npcID":"101002","showText":"这鬼东西……变成的样子，搞得全船团都开始嘲笑我，我都不想回去了。"},"100005":{"id":100005,"soundCue":"","next":100006,"showTime":2,"npcID":"101004","showText":"它变成了什么样？"},"100006":{"id":100006,"soundCue":"","next":0,"showTime":3,"npcID":"101002","showText":"穿着机甲的我老婆。"},"100007":{"id":100007,"soundCue":"","next":0,"showTime":5,"npcID":"101005","showText":"电梯，在修。下面的广场，暂时别去了。"},"100008":{"id":100008,"soundCue":"","next":0,"showTime":4,"npcID":"101006","showText":"博物馆整修中，敬请期待。"},"100009":{"id":100009,"soundCue":"","next":100010,"showTime":8,"npcID":"101007","showText":"「多冰少沙」的限定新品，味道很好吗？"},"100010":{"id":100010,"soundCue":"","next":100011,"showTime":5,"npcID":"101008","showText":"呃……甜，好甜啊，不合我口味。"},"100011":{"id":100011,"soundCue":"","next":100012,"showTime":2,"npcID":"101009","showText":"那你……这几天不是都在买？"},"100012":{"id":100012,"soundCue":"","next":100013,"showTime":4,"npcID":"101008","showText":"它，它附送TRR级战斗模型啊。"},"100013":{"id":100013,"soundCue":"","next":0,"showTime":2,"npcID":"101009","showText":"哦。行吧。"},"100014":{"id":100014,"soundCue":"","next":100015,"showTime":5,"npcID":"101010","showText":"「红王白后」放出来的预约量，好像比上个月更少了。"},"100015":{"id":100015,"soundCue":"","next":0,"showTime":5,"npcID":"101011","showText":"唉……我已经整整一年没能预约到汞珠糖本人了。"},"100016":{"id":100016,"soundCue":"","next":100017,"showTime":5,"npcID":"101012","showText":"来，给你看，我的单推团，马尾草。"},"100017":{"id":100017,"soundCue":"","next":100018,"showTime":5,"npcID":"101013","showText":"你又换单推了？说好的单推幸福双子呢？"},"100018":{"id":100018,"soundCue":"","next":0,"showTime":5,"npcID":"101012","showText":"单推幸福双子，和单推马尾草，矛盾吗？"},"100019":{"id":100019,"soundCue":"","next":100020,"showTime":2,"npcID":"101014","showText":"想回去……打游戏……"},"100020":{"id":100020,"soundCue":"","next":100021,"showTime":3,"npcID":"101015","showText":"啊？我们才出来一个小时吧？"},"100021":{"id":100021,"soundCue":"","next":0,"showTime":6,"npcID":"101014","showText":"是「已经」出来一个小时了——放我回去啦，拜托。"},"100022":{"id":100022,"soundCue":"","next":100023,"showTime":4,"npcID":"101016","showText":"你们最近……月考，刚结束吧？"},"100023":{"id":100023,"soundCue":"","next":100024,"showTime":4,"npcID":"101017","showText":"呃，啊，对。考了。"},"100024":{"id":100024,"soundCue":"","next":100025,"showTime":2,"npcID":"101016","showText":"成绩出来了吗？"},"100025":{"id":100025,"soundCue":"","next":100026,"showTime":1,"npcID":"101017","showText":"没出来。"},"100026":{"id":100026,"soundCue":"","next":0,"showTime":4,"npcID":"101016","showText":"你这反应，不太像没出来喔。"},"100027":{"id":100027,"soundCue":"","next":100028,"showTime":7,"npcID":"101018","showText":"结婚周年纪念，想去金星天的「酒池」玩一圈……"},"100028":{"id":100028,"soundCue":"","next":100029,"showTime":3,"npcID":"101019","showText":"准备了多少预算？"},"100029":{"id":100029,"soundCue":"","next":0,"showTime":4,"npcID":"101018","showText":"预算……啊……我现在已经开始头疼了……"},"100030":{"id":100030,"soundCue":"","next":100031,"showTime":10,"npcID":"101020","showText":"你之前推荐的那种营养素，叫什么名字来着？我最近也开始种点太空植物了。"},"100031":{"id":100031,"soundCue":"","next":100032,"showTime":3,"npcID":"101021","showText":"哦，那个啊，叫「金疙瘩」。"},"100032":{"id":100032,"soundCue":"","next":100033,"showTime":2,"npcID":"101020","showText":"名字好傻。"},"100033":{"id":100033,"soundCue":"","next":0,"showTime":1,"npcID":"101021","showText":"是吧。"},"100034":{"id":100034,"soundCue":"","next":100035,"showTime":3,"npcID":"101022","showText":"新游戏机？看着真棒啊……"},"100035":{"id":100035,"soundCue":"","next":100036,"showTime":4,"npcID":"101023","showText":"是啊，不过我这个月都只能吃代餐糊精了。"},"100036":{"id":100036,"soundCue":"","next":100037,"showTime":7,"npcID":"101022","showText":"不至于啦，来，晚上我请你吃……机器借我玩玩就好。"},"100037":{"id":100037,"soundCue":"","next":0,"showTime":2,"npcID":"101023","showText":"哎哟？谢谢老板。"},"100038":{"id":100038,"soundCue":"","next":100039,"showTime":4,"npcID":"101024","showText":"前两天，买了个新的清洁狗。"},"100039":{"id":100039,"soundCue":"","next":100040,"showTime":2,"npcID":"101025","showText":"感觉如何？"},"100040":{"id":100040,"soundCue":"","next":0,"showTime":6,"npcID":"101024","showText":"至少我家猫挺喜欢的——生物意义上的猫。"},"100041":{"id":100041,"soundCue":"","next":100042,"showTime":5,"npcID":"101026","showText":"听说了吗？「信风」又重新活动了。"},"100042":{"id":100042,"soundCue":"","next":100043,"showTime":5,"npcID":"101027","showText":"人人都知道。而且他的赏金额……最近又提了一倍。"},"100043":{"id":100043,"soundCue":"","next":100044,"showTime":2,"npcID":"101026","showText":"你想拿？"},"100044":{"id":100044,"soundCue":"","next":0,"showTime":4,"npcID":"101027","showText":"呵，谁拿得起？反正我没这胆子。"},"100045":{"id":100045,"soundCue":"","next":100046,"showTime":4,"npcID":"101028","showText":"这条街现在……变成这样了啊。"},"100046":{"id":100046,"soundCue":"","next":0,"showTime":5,"npcID":"101029","showText":"记得小时候，经常来买玩具和战斗模型……"},"100047":{"id":100047,"soundCue":"","next":0,"showTime":4,"npcID":"101030","showText":"欢迎光临「莲花王宫酒店」。"},"100048":{"id":100048,"soundCue":"","next":0,"showTime":5,"npcID":"101031","showText":"您的下榻为莲花王宫增添了无上光彩。"},"100049":{"id":100049,"soundCue":"","next":0,"showTime":6,"npcID":"101032","showText":"您的下榻为莲花王宫增添了无上光彩。"},"200010":{"id":200010,"soundCue":"","next":0,"showTime":3,"npcID":"201005","showText":"至于现在，就先被我征用啦。"},"300000":{"id":300000,"soundCue":"","next":300001,"showTime":4,"npcID":"301001","showText":"我们分部最近在「水星天」开了点业务。"},"300001":{"id":300001,"soundCue":"","next":300002,"showTime":5,"npcID":"301002","showText":"那不挺好的吗？你不是经常说不想再呆这了么？"},"300002":{"id":300002,"soundCue":"","next":0,"showTime":4,"npcID":"301001","showText":"但我也不想去「水星天」啊。"},"300003":{"id":300003,"soundCue":"","next":300004,"showTime":4,"npcID":"301003","showText":"你怎么一副垂头丧气的样子？"},"300004":{"id":300004,"soundCue":"","next":300005,"showTime":2,"npcID":"301004","showText":"想想股市。"},"300005":{"id":300005,"soundCue":"","next":0,"showTime":1,"npcID":"301003","showText":"哦。"},"708011":{"id":708011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10801/Cue/SC_10801_start_VS.SC_10801_start_VS'","next":0,"showTime":2,"npcID":"700001","showText":"小心，不要把防晒油滴到草坪上哦。"},"708012":{"id":708012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10801/Cue/SC_10801_tease_a_VS.SC_10801_tease_a_VS'","next":0,"showTime":2,"npcID":"700001","showText":"啊——谢谢。等会换我来帮你涂吧。"},"708013":{"id":708013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10801/Cue/SC_10801_end0_VS.SC_10801_end0_VS'","next":0,"showTime":2,"npcID":"700001","showText":"难离山庄永远欢迎你——当然，现在也可以尝尝我从山庄带来的点心。"},"708014":{"id":708014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10801/Cue/SC_10801_end1_VS.SC_10801_end1_VS'","next":0,"showTime":2,"npcID":"700001","showText":"乖，要做个好孩子哦。"},"707011":{"id":707011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_tease_a_VS.SC_10701_tease_a_VS'","next":0,"showTime":2,"npcID":"700001","showText":"嘶……当心点！动作要轻柔啊！"},"707012":{"id":707012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_tabletPC_VS.SC_10701_tabletPC_VS'","next":0,"showTime":2,"npcID":"700001","showText":"不给你看！这是精英人士的网络水军小秘密。"},"707013":{"id":707013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_Shower_VS.SC_10701_Shower_VS'","next":0,"showTime":2,"npcID":"700001","showText":"怎么？被我的美完全震慑了吗？"},"707014":{"id":707014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_Shower_end_VS.SC_10701_Shower_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"我的新发型明天就到货了。呵，想象那飘逸的长发在水花中旋舞的姿态吧……"},"707015":{"id":707015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_tease_h_VS.SC_10701_tease_h_VS'","next":0,"showTime":2,"npcID":"700001","showText":"保持体态，是律师分内之事……这饮料是无糖的吧？"},"707016":{"id":707016,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/10701/Cue/SC_10701_end_VS.SC_10701_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"赛文楼德大王是谁？小心别被骗了，需要我检查一下你们的合同吗？"},"400000":{"id":400000,"soundCue":"","next":400001,"showTime":3,"npcID":"401001","showText":"怎么，见到我很惊讶吗？"},"400001":{"id":400001,"soundCue":"","next":400002,"showTime":4,"npcID":"401001","showText":"在我的「时珊瑚枝」上，我是胜者。"},"400002":{"id":400002,"soundCue":"","next":400003,"showTime":6,"npcID":"401001","showText":"我估计，大部分「时珊瑚枝」的结局都是如此吧。"},"400003":{"id":400003,"soundCue":"","next":400004,"showTime":7,"npcID":"401001","showText":"平行世界的我，居然被困在那种躯壳里……太可笑了。"},"400004":{"id":400004,"soundCue":"","next":400005,"showTime":9,"npcID":"401001","showText":"好了，快带着那只一点都不吉祥的吉祥物离开，我不想多看它一眼。"},"400005":{"id":400005,"soundCue":"","next":0,"showTime":5,"npcID":"401001","showText":"我们就在「下次的故事」里，再相见吧。"},"706011":{"id":706011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_MassageGun_strat_VS.SC_1006_MassageGun_strat_VS'","next":0,"showTime":2,"npcID":"700001","showText":"怎么办呢？总之还是得按摩一下，这两条无用的木桩……"},"706012":{"id":706012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_tease_i_VS.SC_1006_tease_i_VS'","next":0,"showTime":2,"npcID":"700001","showText":"（舒适的呻吟声）"},"706013":{"id":706013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_MassageGun_end_VS.SC_1006_MassageGun_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"下次，还要再麻烦你帮忙了。"},"706014":{"id":706014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_end0_VS.SC_1006_end0_VS'","next":0,"showTime":2,"npcID":"700001","showText":"哼哼……「义人」的秘密，其实我已经偷到了哦。"},"706015":{"id":706015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_end1_VS.SC_1006_end1_VS'","next":0,"showTime":2,"npcID":"700001","showText":"又见面了？那就麻烦你再照顾我一段时间啦——或者，不止是「一段时间」？"},"706016":{"id":706016,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1006/Cue/SC_1006_end2_VS.SC_1006_end2_VS'","next":0,"showTime":2,"npcID":"700001","showText":"今天的下午茶，我想要三个贝利环形山产的月球李子，煮过以后先切一刀，往刀口里挤满奶油，然后用内壁擦着肉桂粉和一点点盐的吸管来吸它。"},"500001":{"id":500001,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/mianmian_bubble_01.mianmian_bubble_01'","next":0,"showTime":6,"npcID":"501001","showText":"这是什么？这是22世纪末铁血瑜伽训练。"},"500002":{"id":500002,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/mianmian_bubble_01.mianmian_bubble_01'","next":0,"showTime":6,"npcID":"501002","showText":"这是什么？这是22世纪末铁血瑜伽训练。"},"500003":{"id":500003,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/mianmian_bubble_01.mianmian_bubble_01'","next":0,"showTime":6,"npcID":"501003","showText":"这是什么？这是22世纪末铁血瑜伽训练。"},"500004":{"id":500004,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/mianmian_bubble_02.mianmian_bubble_02'","next":0,"showTime":3,"npcID":"501004","showText":"嗯——这是什么东西呢？"},"500005":{"id":500005,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/shalemei_ren__bubble_01.shalemei_ren__bubble_01'","next":0,"showTime":9,"npcID":"501005","showText":"快带着那只一点都不吉祥的吉祥物离开，我不想多看它一眼。"},"500006":{"id":500006,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/xiaoyu_bubble_01.xiaoyu_bubble_01'","next":0,"showTime":4,"npcID":"501006","showText":"啊，啊哇哇哇哇哇……"},"500007":{"id":500007,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/xiaoyu_bubble_01.xiaoyu_bubble_01'","next":0,"showTime":4,"npcID":"501007","showText":"啊，啊哇哇哇哇哇……"},"500008":{"id":500008,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/xiaoyu_bubble_02.xiaoyu_bubble_02'","next":0,"showTime":2,"npcID":"501008","showText":"哇哇哇……"},"500009":{"id":500009,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/xiaoyu_bubble_02.xiaoyu_bubble_02'","next":0,"showTime":2,"npcID":"501009","showText":"哇哇哇……"},"500010":{"id":500010,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/nijique_bubble_01.nijique_bubble_01'","next":500011,"showTime":5,"npcID":"501010","showText":"这杯特调，我觉得平衡感很不错。"},"500011":{"id":500011,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/nijique_bubble_02.nijique_bubble_02'","next":0,"showTime":2,"npcID":"501010","showText":"你，要喝一口吗？"},"500012":{"id":500012,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/zheguang_bubble_01.zheguang_bubble_01'","next":0,"showTime":2,"npcID":"501011","showText":"检修……检修中。"},"500013":{"id":500013,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/gongzhutang_bubble_01.gongzhutang_bubble_01'","next":0,"showTime":4,"npcID":"501012","showText":"不听话的病人，是工作压力来源的八成……"},"500014":{"id":500014,"soundCue":"/Script/Engine.SoundWave'/Game/_Game/SoundEffects/Voice_Com/biancaiji_bubble_01.biancaiji_bubble_01'","next":0,"showTime":22,"npcID":"501013","showText":"转化发力闭环导流、头部格局长尾落地、干货阈值敏捷评估、高优创新布局痛点、价值流量回顾反哺、生态裂变导流屏障、分发逻辑撬动度量、隔代整合降维操盘……"},"704015":{"id":704015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_WashingMachine_VS.SC_1004_WashingMachine_VS'","next":0,"showTime":2,"npcID":"700001","showText":"咳，咳，好多灰……有没有人啊？谁来把我拽出去？！"},"704016":{"id":704016,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_tease_k_VS.SC_1004_tease_k_VS'","next":0,"showTime":2,"npcID":"700001","showText":"呀啊！唔……不行，卡得太紧了……"},"704017":{"id":704017,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_end_VS.SC_1004_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"先说好，什么命令我都懒得听——不过，是你的话，可以帮忙。"},"200001":{"id":200001,"soundCue":"","next":200002,"showTime":4,"npcID":"201002","showText":"嘘。你说的新老板刚刚路过。"},"712025":{"id":712025,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/11202/Cue/SC_11202_end1_VS.SC_11202_end1_VS'","next":0,"showTime":2,"npcID":"700001","showText":"嗯？什么？现在的你，还天天都能看到这件衣服？"},"712024":{"id":712024,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/11202/Cue/SC_11202_end0_VS.SC_11202_end0_VS'","next":712025,"showTime":2,"npcID":"700001","showText":"啊——很久没穿这件衣服了，你也有点怀念吧？"},"712023":{"id":712023,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/11202/Cue/SC_11202_tease_b_VS.SC_11202_tease_b_VS'","next":0,"showTime":2,"npcID":"700001","showText":"等，等一下！这是什么东西啊？！"},"712022":{"id":712022,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/11202/Cue/SC_11202_tease_end_VS.SC_11202_tease_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"什么都不想，什么都不做，就是最好的时光……"},"712021":{"id":712021,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/11202/Cue/SC_11202_tease_a_VS.SC_11202_tease_a_VS'","next":0,"showTime":2,"npcID":"700001","showText":"唔嗯……触感很不错呢，真希望时间能就这样静止下来……"},"704014":{"id":704014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_tease_i_VS.SC_1004_tease_i_VS'","next":0,"showTime":2,"npcID":"700001","showText":"嗯嗯……好舒服。"},"703011":{"id":703011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_tease_a_VS.SC_1003_tease_a_VS'","next":0,"showTime":2,"npcID":"700001","showText":"呜……嗯。我们的血肉之躯，究竟在孕育什么？"},"703012":{"id":703012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_tease_f_VS.SC_1003_tease_f_VS'","next":0,"showTime":2,"npcID":"700001","showText":"酒中有真知，愿苦短暂，乐永恒。"},"703013":{"id":703013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_Shower_VS.SC_1003_Shower_VS'","next":0,"showTime":2,"npcID":"700001","showText":"嗯？在看这「花染的手掌」吗？"},"703014":{"id":703014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_SunBath_strat_VS.SC_1003_SunBath_strat_VS'","next":0,"showTime":2,"npcID":"700001","showText":"骄阳下，阴影也变得分外清晰。"},"703015":{"id":703015,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_tease_h_VS.SC_1003_tease_h_VS'","next":0,"showTime":2,"npcID":"700001","showText":"无序之都的夏日，真热啊。不过有这冰凉的椰酒在手，也就无所谓了。"},"703016":{"id":703016,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_SunBath_end_VS.SC_1003_SunBath_end_VS'","next":0,"showTime":2,"npcID":"700001","showText":"让我就这样……醉生梦死地……晒着太阳吧……"},"703017":{"id":703017,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_end0_VS.SC_1003_end0_VS'","next":0,"showTime":0,"npcID":"700001","showText":"来，把手给我。蹭一蹭「花染的手掌」，会给你带来一天的微弱好运。"},"703018":{"id":703018,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_end1_VS.SC_1003_end1_VS'","next":0,"showTime":0,"npcID":"700001","showText":"想要「特别优待」？可以啊，我也已经期待了很久……啊，不过在这时间之外，这样说会很奇怪吧。"},"703019":{"id":703019,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1003/Cue/SC_1003_end2_VS.SC_1003_end2_VS'","next":0,"showTime":0,"npcID":"700001","showText":"居然再次跨越时间相见……命运真是离奇，我都有点感动了呢。"},"704013":{"id":704013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_SunBath_VS.SC_1004_SunBath_VS'","next":0,"showTime":2,"npcID":"700001","showText":"啊~暖暖的阳光，让我想起从前在野外生活的日子。"},"704012":{"id":704012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_tease_e_VS.SC_1004_tease_e_VS'","next":0,"showTime":2,"npcID":"700001","showText":""},"704011":{"id":704011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1004/Cue/SC_1004_Chair_VS.SC_1004_Chair_VS'","next":0,"showTime":2,"npcID":"700001","showText":"要是能随便出去玩就好了，可惜我现在是「重要人物」。"},"200002":{"id":200002,"soundCue":"","next":0,"showTime":1,"npcID":"201001","showText":"[虚弱的粗口]"},"200003":{"id":200003,"soundCue":"","next":200004,"showTime":7,"npcID":"201003","showText":"最近，「理事会」给人的感觉特别紧绷。"},"200004":{"id":200004,"soundCue":"","next":200005,"showTime":4,"npcID":"201004","showText":"还有那个信风，好像也重新出现了。"},"200009":{"id":200009,"soundCue":"","next":200010,"showTime":7,"npcID":"201005","showText":"在「下次的故事」里，这个区域是完全由你自己DIY的。"},"200008":{"id":200008,"soundCue":"","next":200009,"showTime":4,"npcID":"201005","showText":"哦……你问我为什么会出现在这里啊。"},"200007":{"id":200007,"soundCue":"","next":200008,"showTime":5,"npcID":"201005","showText":"这是什么？这是23世纪末铁血瑜伽训练。"},"200006":{"id":200006,"soundCue":"","next":0,"showTime":2,"npcID":"201004","showText":"日子……不好过啊。"},"200005":{"id":200005,"soundCue":"","next":200006,"showTime":4,"npcID":"201003","showText":"是啊，我最近把……嗯，你知道的那个「小副业」给停了。算是规避一下风险吧。"},"702011":{"id":702011,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1002/Cue/SC_1002_tease_a_VS.SC_1002_tease_a_VS'","next":0,"showTime":2,"npcID":"700001","showText":"啊……嗯。呼……别着急，一切尽在掌控之中，天体的力量也不能逃脱。"},"702012":{"id":702012,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1002/Cue/SC_1002_tease_g_VS.SC_1002_tease_g_VS'","next":0,"showTime":2,"npcID":"700001","showText":"水流拂过身体，犹如权力在手中流转……唔，真是放松。"},"702013":{"id":702013,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1002/Cue/SC_1002_SunBath_VS.SC_1002_SunBath_VS'","next":0,"showTime":2,"npcID":"700001","showText":"普照世间的日光，实则为我而存在……万物应顺我之威仪。"},"702014":{"id":702014,"soundCue":"/Script/Engine.SoundCue'/Game/_Game/SoundEffects/Voice_Hotel/1002/Cue/SC_1002_end0_VS.SC_1002_end0_VS'","next":702015,"showTime":2,"npcID":"700001","showText":"我主宰的世界自有秩序，渺小的凡人最好学会顺从。"},"200000":{"id":200000,"soundCue":"","next":200001,"showTime":7,"npcID":"201001","showText":"这战舰到底是什么型号？咱们的新老板，说不定有什么黑道背景……"}}