# Dependencies
node_modules/
REVERSE_ENGINEERING.md

# Runtime state — accounts and per-player saves are created by the server
server/data/
# 控制台 restore / load 自动留的存档快照（data_wipe_* / data_preimport_*）
server/data_*
server/logs/
server/logs_stdout.txt

# 首次启动向导的产物（本机相关的游戏路径与自动拉起开关）
server/runtime-config.json
server/auto-launch.flag

# 启动器 Mod 仓库（玩家/社区内容，不入库；目录由启动器自动创建）
server/mods/
!server/mods/.gitkeep

# Temporary / atomic-write leftovers
*.tmp
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
.workbuddy/
.zcode/

# repak 导出的 pak 条目清单（tools/check_weapon_assets.js 的输入，随时可重新生成）
reference/paklist*.txt
